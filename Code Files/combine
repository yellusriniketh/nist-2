import csv
import glob
import re
from pathlib import Path

from openpyxl import Workbook

# Set this to the folder prefix used by the scraper (e.g. "oxygen").
# The script will look for files like <prefix>/<prefix>_*.txt and write <prefix>/<prefix>.xlsx
file_prefix = "methane"
input_dir = Path(file_prefix)


def extract_number(filename):
    # Extract the last sequence of digits in the filename for numeric sorting
    match = re.search(r"(\d+)(?!.*\d)", filename)
    return int(match.group(0)) if match else 0


def parse_cell(value):
    if value is None or value == "":
        return value

    lower_value = str(value).strip().lower()
    if lower_value in {"infinite", "undefined"}:
        return value

    try:
        number = float(value)
    except (TypeError, ValueError):
        return value

    if number.is_integer():
        return int(number)
    return number


def write_group_to_sheet(sheet, files):
    for file_index, file_path in enumerate(files):
        with open(file_path, "r", encoding="utf-8", newline="") as text_file:
            reader = csv.reader(text_file, delimiter="\t")
            for row_index, row in enumerate(reader):
                if file_index > 0 and row_index == 0:
                    continue

                if not row or all(str(cell).strip() == "" for cell in row):
                    continue

                sheet.append([parse_cell(cell) for cell in row])


pattern = str(input_dir / f"{file_prefix}_*.txt")
txt_files = sorted(glob.glob(pattern), key=extract_number)

if not txt_files:
    raise SystemExit(f"No text files found for pattern: {pattern}")

split_index = (len(txt_files) + 1) // 2
first_group = txt_files[:split_index]
second_group = txt_files[split_index:]

output_file = input_dir / f"{file_prefix}.xlsx"
workbook = Workbook(write_only=True)

first_sheet_name = f"p_{extract_number(first_group[0])}to{extract_number(first_group[-1])}"[:31]
first_sheet = workbook.create_sheet(title=first_sheet_name)
write_group_to_sheet(first_sheet, first_group)

if second_group:
    second_sheet_name = f"p_{extract_number(second_group[0])}to{extract_number(second_group[-1])}"[:31]
    second_sheet = workbook.create_sheet(title=second_sheet_name)
    write_group_to_sheet(second_sheet, second_group)

workbook.save(output_file)

sheet_count = 1 + bool(second_group)
print(f"Combined {len(txt_files)} files into {output_file} with {sheet_count} sheet(s)")